{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "games",
  "account_id": "452c33847cf5cb1e46f391fca32fd1b5",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-17",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "services": [
    {
      "binding": "CADAVRE",
      "service": "cadavre"
    },
    {
      "binding": "JEOPARDY",
      "service": "jeopardy"
    },
    {
      "binding": "CLOZE",
      "service": "cloze"
    },
    {
      "binding": "CLI_ADVENTURES",
      "service": "cli-adventures"
    },
    {
      "binding": "CHESS_LM",
      "service": "chess-lm"
    }
  ],
  "vars": {
    "RELEASE": "dev"
  },
  "observability": {
    "enabled": true
  }
}
